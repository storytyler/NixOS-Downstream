# =============================================================================
# HINDSIGHT API SERVICE CONFIGURATION
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string. If not provided, uses embedded pg0 (not recommended for production)
# HINDSIGHT_API_DATABASE_URL=

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
# LLM provider: openai, anthropic, gemini, groq, ollama, lmstudio
HINDSIGHT_API_LLM_PROVIDER=openai

# API key for the LLM provider (not required for ollama/lmstudio)
HINDSIGHT_API_LLM_API_KEY=ccfa6c2a31d54fdb94d1701496bc0ad9.rsvggwa5pyeYPzxo

# LLM model name
HINDSIGHT_API_LLM_MODEL=glm-4.5-air

# Custom LLM endpoint URL (optional, for custom endpoints or Azure OpenAI)
HINDSIGHT_API_LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/

# Maximum concurrent LLM requests (default: 32)
# HINDSIGHT_API_LLM_MAX_CONCURRENT=

# LLM request timeout in seconds (default: 120)
# HINDSIGHT_API_LLM_TIMEOUT=

# =============================================================================
# EMBEDDINGS CONFIGURATION
# =============================================================================
# Embeddings provider: local or tei
# HINDSIGHT_API_EMBEDDINGS_PROVIDER=

# Model for local embeddings provider (default: BAAI/bge-small-en-v1.5)
# HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=

# TEI server URL for embeddings (if using tei provider)
# HINDSIGHT_API_EMBEDDINGS_TEI_URL=

# =============================================================================
# RERANKER CONFIGURATION
# =============================================================================
# Reranker provider: local or tei
# HINDSIGHT_API_RERANKER_PROVIDER=

# Model for local reranker provider (default: cross-encoder/ms-marco-MiniLM-L-6-v2)
# HINDSIGHT_API_RERANKER_LOCAL_MODEL=

# TEI server URL for reranker (if using tei provider)
# HINDSIGHT_API_RERANKER_TEI_URL=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Server bind address (default: 0.0.0.0)
# HINDSIGHT_API_HOST=

# Server port (default: 8888)
# HINDSIGHT_API_PORT=

# Log level: debug, info, warning, error (default: info)
# HINDSIGHT_API_LOG_LEVEL=

# Enable MCP server at /mcp/{bank_id}/ (default: true)
# HINDSIGHT_API_MCP_ENABLED=

# =============================================================================
# RETRIEVAL CONFIGURATION
# =============================================================================
# Graph retrieval algorithm: bfs or mpfp (default: bfs)
# HINDSIGHT_API_GRAPH_RETRIEVER=

# =============================================================================
# ENTITY OBSERVATIONS CONFIGURATION
# =============================================================================
# Minimum facts about an entity before generating observations (default: 5)
# HINDSIGHT_API_OBSERVATION_MIN_FACTS=

# Maximum entities to process per retain batch (default: 5)
# HINDSIGHT_API_OBSERVATION_TOP_ENTITIES=

# =============================================================================
# LOCAL MCP SERVER CONFIGURATION
# =============================================================================
# Memory bank ID for local MCP server (default: mcp)
# HINDSIGHT_API_MCP_LOCAL_BANK_ID=

# Additional instructions appended to retain/recall tool descriptions
# HINDSIGHT_API_MCP_INSTRUCTIONS=

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
# Skip LLM connection check on startup (default: false)
# HINDSIGHT_API_SKIP_LLM_VERIFICATION=

# Lazy-load reranker model for faster startup (default: false)
# HINDSIGHT_API_LAZY_RERANKER=

# =============================================================================
# CONTROL PLANE CONFIGURATION
# =============================================================================
# URL of the Hindsight API service (default: http://localhost:8888)
# HINDSIGHT_CP_DATAPLANE_API_URL=
