{
    "database": {
        "provider": "duckdb",
        "path": ".chunkhound"
    },
    "embedding": {
        "provider": "openai",
        "base_url": "http://localhost:11434/v1",
        "model": "dengcao/Qwen3-Embedding-8B:Q5_K_M",
        "rerank_model": "dengcao/Qwen3-Reranker-4B:Q5_K_M"
    },
    "llm": {
        "provider": "ollama",
        "base_url": "http://localhost:11434/v1",
        "utility_model": "llama3.2",
        "synthesis_model": "gpt-oss:20b"
    },
    "indexing": {
        "include": [
            "**/*.py",
            "**/*.js",
            "**/*.ts",
            "**/*.nix"
        ],
        "exclude": [
            "**/node_modules/**",
            "**/__pycache__/**"
        ]
    },
    "mcp": {
        "transport": "stdio",
        "host": "0.0.0.0",
        "port": 3000
    },
    "debug": false
}